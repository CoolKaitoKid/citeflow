<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - CITE-Flow</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        
        * { font-family: 'Inter', sans-serif; }
        
        .sidebar { 
            background-color: #621708; 
            width: 280px;
        }
        
        .nav-item { 
            transition: all 0.3s ease; 
        }
        .nav-item:hover { 
            background-color: #8c2a10; 
        }
        .nav-item.active { 
            background-color: #8c2a10; 
            border-left: 4px solid #f5e8c7; 
        }

        .section-header {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.8px;
            opacity: 0.75;
            padding-left: 20px;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .sidebar-scroll::-webkit-scrollbar { 
            width: 4px; 
        }
        .sidebar-scroll::-webkit-scrollbar-thumb { 
            background-color: rgba(255,255,255,0.35); 
            border-radius: 20px; 
        }

        .card-shadow { 
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.05); 
        }

        .nav-icon {
            width: 20px;
            height: 20px;
            stroke: currentColor;
            stroke-width: 2.25;
        }

        .chat-window {
            box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.45);
        }

        /* Selected tags: grows up to ~2 rows, then becomes scrollable */
        #selected-tags {
            max-height: 85px;
            overflow-y: auto;
            scrollbar-width: thin;
        }
        #selected-tags::-webkit-scrollbar {
            width: 4px;
        }
        #selected-tags::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 20px;
        }

        .message-bubble {
            max-width: 75%;
            padding: 12px 16px;
            border-radius: 20px;
            position: relative;
        }
        
        .message-received {
            background-color: #f1f5f9;
            border-bottom-left-radius: 4px;
        }
        
        .message-sent {
            background-color: #621708;
            color: white;
            border-bottom-right-radius: 4px;
        }

        .chat-messages {
            scrollbar-width: thin;
        }
        .chat-messages::-webkit-scrollbar {
            width: 6px;
        }
        .chat-messages::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 20px;
        }

        .recent-item {
            transition: all 0.2s ease;
        }
        .recent-item:hover {
            background-color: #f8fafc;
        }

        .message-status {
            font-size: 10px;
            opacity: 0.8;
        }

        #new-message-fab {
            transition: all 0.2s ease;
        }
    </style>
</head>
<body class="bg-gray-50">

<div class="flex h-screen overflow-hidden">
    <!-- SIDEBAR -->

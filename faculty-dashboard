</div>

<!-- FLOATING MESSAGING (main trigger) -->
<div id="main-messaging-fab" class="fixed bottom-6 right-6 z-[100]">
    <button onclick="toggleMessaging()" 
            class="w-16 h-16 bg-[#621708] hover:bg-[#8c2a10] text-white rounded-3xl flex items-center justify-center shadow-2xl transition-all hover:scale-110 active:scale-95">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2 2 2 0 01-2-2 2 2 0 012-2 2 2 0 01-2-2 2 2 0 012-2z" />
        </svg>
    </button>
</div>

<div id="messaging-window" class="hidden fixed bottom-8 right-8 w-[360px] h-[520px] bg-white text-gray-900 rounded-3xl overflow-hidden border border-gray-200 chat-window flex flex-col md:bottom-12">
    <!-- Header -->
    <div class="px-4 py-3 border-b flex items-center justify-between bg-[#621708] text-white">
        <div class="flex items-center gap-x-3">
            <button id="back-button" onclick="goBack()" 
                    class="hidden p-1.5 hover:bg-white/20 rounded-xl transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
            </button>
            <div id="message-header-title" class="font-semibold text-lg">Messages</div>
        </div>
        <div class="flex items-center gap-4">
            <button onclick="expandMessaging()" class="text-xl">⬜</button>
            <button onclick="toggleMessaging()" class="text-2xl leading-none">×</button>
        </div>
    </div>

    <!-- Recent Messages List -->
    <div id="recent-messages-screen" class="flex-1 flex flex-col min-h-0 relative">
        <div id="recent-list" class="flex-1 overflow-y-auto"></div>
        
        <!-- Floating New Message Button -->
        <button id="floating-new-message-btn" onclick="showNewMessageScreen()" 
                class="hidden absolute bottom-6 right-6 w-12 h-12 bg-[#621708] hover:bg-[#8c2a10] text-white rounded-3xl flex items-center justify-center shadow-xl z-10">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
        </button>
    </div>

    <!-- New Message Screen -->
    <div id="new-message-screen" class="hidden flex-1 flex flex-col min-h-0">
        <!-- To: Selected Tags -->
        <div class="px-4 pt-3 pb-2 border-b bg-white">
            <div class="text-sm text-gray-500 mb-1">To:</div>
            <div id="selected-tags" class="flex flex-wrap gap-2 pr-2"></div>
        </div>

        <!-- Search -->
        <div class="p-4 border-b bg-white">
            <div class="relative">
                <input id="new-msg-search" type="text" placeholder="Search faculty..." 
                       class="w-full bg-gray-100 rounded-3xl px-5 py-3 pl-12 text-sm focus:outline-none"
                       onkeyup="filterFacultyList()">
                <span class="absolute left-5 top-1/2 -translate-y-1/2 text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 01-14 0 7 7 0 0114 0z" />
                    </svg>
                </span>
            </div>
        </div>

        <!-- Scrollable Faculty List -->
        <div class="flex-1 overflow-y-auto bg-white min-h-0" id="faculty-list"></div>

        <!-- Fixed Chat Button -->
        <div class="p-4 border-t bg-white shrink-0">
            <button onclick="startSelectedChat()" id="start-chat-btn"
                    class="w-full bg-[#621708] hover:bg-[#8c2a10] text-white py-3.5 rounded-3xl font-medium">
                Chat
            </button>
        </div>
    </div>

    <!-- Chat Screen -->
    <div id="chat-screen" class="hidden flex-1 flex flex-col min-h-0">
        <!-- Chat Header -->
        <div id="chat-header" class="px-4 py-3 border-b bg-white flex items-center gap-3">
            <!-- Populated by JS -->
        </div>

        <!-- Messages Area -->
        <div id="chat-messages" class="flex-1 overflow-y-auto p-4 space-y-4 chat-messages bg-gray-50"></div>

        <!-- Message Input -->
        <div class="p-4 border-t bg-white">
            <div class="flex gap-2">
                <input id="chat-input" 
                       type="text" 
                       placeholder="Type a message..." 
                       class="flex-1 bg-gray-100 border border-gray-200 rounded-3xl px-5 py-3 text-sm focus:outline-none focus:border-[#621708]"
                       onkeypress="if(event.key === 'Enter') sendMessage()">
                <button onclick="sendMessage()" 
                        class="w-11 h-11 bg-[#621708] hover:bg-[#8c2a10] text-white rounded-2xl flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.874L5.999 12zm0 0h7.07" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let activitiesChart = null;

    function initDonutChart() {
        const ctx = document.getElementById('activities-donut');
        if (activitiesChart) activitiesChart.destroy();
        activitiesChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                datasets: [{
                    data: [45, 25, 30],
                    backgroundColor: ['#14b8a6', '#ef4444', '#eab308'],
                    borderWidth: 0,
                    cutout: '78%'
                }]
            },
            options: {
                responsive: true,
                plugins: { 
                    legend: { display: false }, 
                    tooltip: { enabled: false } 
                }
            }
        });
    }

    function quickAction(action) {
        if (action === 'upload') alert('Upload New Document modal opened');
        else if (action === 'submit') alert('Submit for Approval started');
        else if (action === 'analytics') alert('Analytics page opened');
    }

    // ==================== MESSAGING ====================
    let selectedFaculty = [];
    let currentConversationKey = null;
    let conversations = {}; 

    const facultyMembers = [
        { name: "Prof. Juan Cruz", username: "juan.cruz" },
        { name: "Prof. Anna Rodriguez", username: "anna.rodriguez" },
        { name: "Prof. Carlos Mendoza", username: "carlos.mendoza" },
        { name: "Prof. Elena Bautista", username: "elena.bautista" },
        { name: "Dr. Ramon Santos", username: "ramon.santos" }
    ];

    function toggleMessaging() {
        const win = document.getElementById('messaging-window');
        const fab = document.getElementById('main-messaging-fab');
        
        win.classList.toggle('hidden');
        if (!win.classList.contains('hidden')) {
            fab.style.display = 'none';
            showRecentMessages();
        } else {
            fab.style.display = 'block';
        }
    }

    function expandMessaging() {
        const win = document.getElementById('messaging-window');
        win.style.height = (win.style.height === '580px' || win.style.height === '') ? '520px' : '580px';
    }

    function showRecentMessages() {
        document.getElementById('recent-messages-screen').classList.remove('hidden');
        document.getElementById('new-message-screen').classList.add('hidden');
        document.getElementById('chat-screen').classList.add('hidden');
        document.getElementById('message-header-title').textContent = "Messages";
        document.getElementById('back-button').classList.add('hidden');
        selectedFaculty = [];
        currentConversationKey = null;
        renderRecentMessages();
    }

    function showNewMessageScreen() {
        document.getElementById('recent-messages-screen').classList.add('hidden');
        document.getElementById('new-message-screen').classList.remove('hidden');
        document.getElementById('chat-screen').classList.add('hidden');
        document.getElementById('message-header-title').textContent = "New message";
        document.getElementById('back-button').classList.remove('hidden');
        selectedFaculty = [];
        renderSelectedTags();
        renderFacultyList();
    }

    function goBack() {
        if (!document.getElementById('chat-screen').classList.contains('hidden')) {
            showRecentMessages();
        } else if (!document.getElementById('new-message-screen').classList.contains('hidden')) {
            showRecentMessages();
        } else {
            showRecentMessages();
        }
    }

    function renderSelectedTags() {
        const container = document.getElementById('selected-tags');
        let html = '';
        selectedFaculty.forEach((faculty, index) => {
            html += `
                <div class="inline-flex items-center bg-blue-100 text-blue-700 text-sm px-3 py-1 rounded-3xl">
                    ${faculty.name}
                    <span onclick="removeSelected(${index}); event.stopImmediatePropagation()" class="ml-2 cursor-pointer hover:text-red-600 font-bold">×</span>
                </div>`;
        });
        container.innerHTML = html;
    }

    function removeSelected(index) {
        selectedFaculty.splice(index, 1);
        renderSelectedTags();
        renderFacultyList();
    }

    function renderFacultyList(filtered = facultyMembers) {
        let html = '';
        filtered.forEach((faculty, index) => {
            const isSelected = selectedFaculty.some(f => f.name === faculty.name);
            html += `
                <div onclick="toggleFaculty(${index})" class="px-4 py-3 hover:bg-gray-100 cursor-pointer flex items-center gap-3 border-b">
                    <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center text-2xl">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7" />
                        </svg>
                    </div>
                    <div class="flex-1">
                        <div class="font-medium">${faculty.name}</div>
                        <div class="text-sm text-gray-500">${faculty.username}</div>
                    </div>
                    <div class="${isSelected ? 'bg-[#621708] text-white' : 'border-2 border-gray-300'} w-6 h-6 rounded-full flex items-center justify-center text-sm">
                        ${isSelected ? '✓' : ''}
                    </div>
                </div>`;
        });
        document.getElementById('faculty-list').innerHTML = html;
    }

    function toggleFaculty(index) {
        const faculty = facultyMembers[index];
        const exists = selectedFaculty.findIndex(f => f.name === faculty.name);
        if (exists > -1) {
            selectedFaculty.splice(exists, 1);
        } else {
            selectedFaculty.push(faculty);
        }
        renderSelectedTags();
        renderFacultyList();
    }

    function filterFacultyList() {
        const term = document.getElementById('new-msg-search').value.toLowerCase();
        const filtered = facultyMembers.filter(f => 
            f.name.toLowerCase().includes(term) || f.username.toLowerCase().includes(term)
        );
        renderFacultyList(filtered);
    }

    function getConversationKey(participants) {
        const usernames = participants.map(f => f.username).sort();
        return usernames.join(',');
    }

    function getParticipantsFromKey(key) {
        return key.split(',').map(username => {
            return facultyMembers.find(f => f.username === username) || { name: username, username: username };
        });
    }

    function renderRecentMessages() {
        const container = document.getElementById('recent-list');
        const hasConversations = Object.keys(conversations).length > 0;
        
        let html = '';

        if (!hasConversations) {
            html = `
                <div class="flex flex-col items-center justify-center h-full text-center p-8">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20 text-gray-300 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2 2 2 0 01-2-2 2 2 0 012-2 2 2 0 01-2-2z" />
                    </svg>
                    <p class="text-xl font-medium text-gray-600 mb-2">No messages yet</p>
                    <p class="text-gray-500 mb-8">Start a conversation</p>
                    <button onclick="showNewMessageScreen()" 
                            class="flex items-center gap-2 bg-[#621708] hover:bg-[#8c2a10] text-white px-6 py-3 rounded-3xl font-medium">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        New Message
                    </button>
                </div>`;
            document.getElementById('floating-new-message-btn').classList.add('hidden');
        } else {
            const sortedKeys = Object.keys(conversations).sort((a, b) => {
                const lastA = conversations[a][conversations[a].length - 1];
                const lastB = conversations[b][conversations[b].length - 1];
                return new Date(lastB.time || 0) - new Date(lastA.time || 0);
            });

            sortedKeys.forEach(key => {
                const msgs = conversations[key];
                const lastMsg = msgs[msgs.length - 1];
                const participants = getParticipantsFromKey(key);
                const displayName = participants.map(p => p.name).join(', ');
                const isGroup = participants.length > 1;
                
                const preview = lastMsg.text.length > 45 
                    ? lastMsg.text.substring(0, 42) + '...' 
                    : lastMsg.text;

                html += `
                    <div onclick="openExistingChat('${key}')" class="recent-item px-4 py-4 border-b cursor-pointer flex gap-3">
                        <div class="w-11 h-11 bg-gray-200 rounded-2xl flex items-center justify-center flex-shrink-0 text-2xl">
                            ${isGroup ? '👥' : '👤'}
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex justify-between items-baseline">
                                <div class="font-semibold text-base truncate">${displayName}</div>
                                <div class="text-xs text-gray-500 whitespace-nowrap ml-2">${lastMsg.time}</div>
                            </div>
                            <div class="text-sm text-gray-600 truncate mt-0.5">${preview}</div>
                        </div>
                    </div>`;
            });
            document.getElementById('floating-new-message-btn').classList.remove('hidden');
        }

        container.innerHTML = html;
    }

    function openExistingChat(key) {
        currentConversationKey = key;
        const participants = getParticipantsFromKey(key);
        selectedFaculty = participants;

        document.getElementById('recent-messages-screen').classList.add('hidden');
        document.getElementById('new-message-screen').classList.add('hidden');
        document.getElementById('chat-screen').classList.remove('hidden');
        
        document.getElementById('message-header-title').textContent = "Chat";
        document.getElementById('back-button').classList.remove('hidden');
        
        renderChatHeader();
        renderChatMessages();

        // Simulate "Seen" for previous messages when opening chat (recipient viewed)
        simulateSeenForAllMessages(key);
    }

    function simulateSeenForAllMessages(key) {
        if (!conversations[key]) return;
        
        conversations[key].forEach((msg, index) => {
            if (msg.sender !== "maria.santos" && msg.status !== 'seen') {
                setTimeout(() => {
                    if (conversations[key] && conversations[key][index]) {
                        conversations[key][index].status = 'seen';
                        if (currentConversationKey === key) {
                            renderChatMessages();
                        }
                    }
                }, 600 + index * 300);
            }
        });
    }

    function startSelectedChat() {
        if (selectedFaculty.length === 0) return;

        currentConversationKey = getConversationKey(selectedFaculty);
        
        document.getElementById('new-message-screen').classList.add('hidden');
        document.getElementById('recent-messages-screen').classList.add('hidden');
        document.getElementById('chat-screen').classList.remove('hidden');
        
        renderChatHeader();
        
        if (!conversations[currentConversationKey]) {
            conversations[currentConversationKey] = [];
        }
        
        renderChatMessages();
    }

    function renderChatHeader() {
        const header = document.getElementById('chat-header');
        let names = selectedFaculty.map(f => f.name).join(', ');
        if (names.length > 35) names = names.substring(0, 32) + '...';
        
        header.innerHTML = `
            <div class="flex items-center gap-3 flex-1 min-w-0">
                <div class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center flex-shrink-0">
                    👥
                </div>
                <div class="min-w-0">
                    <div class="font-semibold text-base truncate">${names}</div>
                    <div class="text-xs text-green-600">Online</div>
                </div>
            </div>
        `;
    }

    function renderChatMessages() {
        const container = document.getElementById('chat-messages');
        const messages = conversations[currentConversationKey] || [];
        let html = '';
        
        messages.forEach((msg) => {
            const isSent = msg.sender === "maria.santos";
            let statusHTML = '';
            
            if (isSent && msg.status) {
                let statusText = msg.status.charAt(0).toUpperCase() + msg.status.slice(1);
                statusHTML = `<div class="text-[10px] mt-1 opacity-70 text-right message-status">${statusText}</div>`;
            }
            
            html += `
                <div class="flex ${isSent ? 'justify-end' : 'justify-start'}">
                    <div class="${isSent ? 'message-sent' : 'message-received'} message-bubble">
                        <div class="text-sm">${msg.text}</div>
                        ${statusHTML}
                        <div class="text-[10px] mt-1 opacity-70 text-right">${msg.time}</div>
                    </div>
                </div>
            `;
        });
        
        if (messages.length === 0) {
            html = `
                <div class="flex flex-col items-center justify-center h-full text-center text-gray-400 py-12">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2 2 2 0 01-2-2 2 2 0 012-2 2 2 0 01-2-2z" />
                    </svg>
                    <p class="text-sm">No messages yet</p>
                    <p class="text-xs mt-1">Send the first message to start the conversation</p>
                </div>
            `;
        }
        
        container.innerHTML = html;
        container.scrollTop = container.scrollHeight;
    }

    function sendMessage() {
        const input = document.getElementById('chat-input');
        const text = input.value.trim();
        
        if (!text || !currentConversationKey) return;
        
        const now = new Date();
        const time = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        
        if (!conversations[currentConversationKey]) {
            conversations[currentConversationKey] = [];
        }
        
        const newMessage = {
            sender: "maria.santos",
            text: text,
            time: time,
            status: 'sent'
        };
        
        conversations[currentConversationKey].push(newMessage);
        
        input.value = '';
        renderChatMessages();
        
        // Real-time status progression
        simulateMessageStatusUpdate(currentConversationKey, conversations[currentConversationKey].length - 1);
        
        if (!document.getElementById('recent-messages-screen').classList.contains('hidden')) {
            renderRecentMessages();
        }
    }

    function simulateMessageStatusUpdate(conversationKey, messageIndex) {
        // Delivered after a short delay
        setTimeout(() => {
            if (conversations[conversationKey] && conversations[conversationKey][messageIndex]) {
                conversations[conversationKey][messageIndex].status = 'delivered';
                if (currentConversationKey === conversationKey) {
                    renderChatMessages();
                }
                if (!document.getElementById('recent-messages-screen').classList.contains('hidden')) {
                    renderRecentMessages();
                }
            }
        }, 900);

        // Seen after longer delay (simulating recipient opening chat)
        setTimeout(() => {
            if (conversations[conversationKey] && conversations[conversationKey][messageIndex]) {
                conversations[conversationKey][messageIndex].status = 'seen';
                if (currentConversationKey === conversationKey) {
                    renderChatMessages();
                }
                if (!document.getElementById('recent-messages-screen').classList.contains('hidden')) {
                    renderRecentMessages();
                }
            }
        }, 2500);
    }

    window.onload = () => {
        initDonutChart();
    };
</script>
</body>
</html>

function Post($path, $body) {
  try {
    $resp = Invoke-WebRequest -Uri ($base+$path) -Headers $h -Method Post -Body $body -ContentType 'application/json' -ErrorAction Stop
    return @{ code=[int]$resp.StatusCode; body=$resp.Content }
  } catch {
    $b=''
    try { $sr = New-Object System.IO.StreamReader($_.Exception.Response.GetResponseStream()); $b=$sr.ReadToEnd() } catch { $b='<unreadable>' }
    return @{ code=[int]$_.Exception.Response.StatusCode; body=$b }
  }
}

